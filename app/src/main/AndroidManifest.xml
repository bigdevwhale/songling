<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Covers, genres and years (iTunes), countries (MusicBrainz), band pictures (Deezer) and the weather in the window (Open-Meteo, MET Norway). -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- To list the players on the phone when choosing which ones Songling listens to (Settings → Counting). -->
    <queries>
        <intent>
            <action android:name="android.media.browse.MediaBrowserService" />
        </intent>
        <package android:name="com.spotify.music" />
        <package android:name="ru.yandex.music" />
        <package android:name="com.google.android.apps.youtube.music" />
        <package android:name="com.google.android.youtube" />
        <package android:name="com.vkontakte.android" />
        <package android:name="com.uma.musicvk" />
        <package android:name="com.apple.android.music" />
        <package android:name="com.soundcloud.android" />
        <package android:name="deezer.android.app" />
        <package android:name="com.zvooq.openplay" />
        <package android:name="ru.mts.music.android" />
        <package android:name="com.maxmpz.audioplayer" />
        <package android:name="in.krosbits.musicolet" />
        <package android:name="com.aimp.player" />
        <package android:name="com.miui.player" />
        <package android:name="com.sec.android.app.music" />
        <package android:name="com.amazon.mp3" />
        <package android:name="com.aspiro.tidal" />
        <package android:name="com.pandora.android" />
        <package android:name="app.revanced.android.apps.youtube.music" />
        <package android:name="com.kapp.youtube.final" />
        <package android:name="org.schabi.newpipe" />
        <package android:name="com.bandcamp.android" />
    </queries>

    <application
        android:name=".SonglingApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Songling">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Sees what any player is playing (title, artist, album) through its media session. Nothing else is read. -->
        <service
            android:name=".listen.Listener"
            android:exported="true"
            android:label="@string/listener_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <receiver
            android:name=".widget.DenWidget"
            android:exported="false"
            android:label="@string/widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_den" />
        </receiver>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/shared_files" />
        </provider>

        <!-- Persists the in-app language choice on Android 12 and older. -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>
    </application>
</manifest>
